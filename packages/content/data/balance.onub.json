      "text": "The Mother Dough was ruined at prep: Team Mold wins."
    },
    {
      "id": "sporeOut",
      "when": { "sporeOut": true },
      "winners": ["baker"],
      "text": "A Mold Spore went in the oven: the Loyal Bakers win."
    },
    {
      "id": "sporesHide",
      "when": { "sporeAmongPlayers": true },
      "winners": ["mold"],
      "text": "No Mold Spore went in the oven: Team Mold wins, even those who were baked."
    },
    {
      "id": "cleanTable",
      "when": { "anyoneOut": false },
      "winners": ["baker"],
      "text": "Every Mold Spore was in the Pantry and nobody went in the oven: the Loyal Bakers win."
    },
    {
      "id": "moldOut",
      "when": { "moldOut": true },
      "winners": ["baker"],
      "text": "No Spore was at the table and Team Mold went in the oven: the Loyal Bakers win."
    },
    {
      "id": "wrongOven",
      "when": { "anyoneOut": true },
      "winners": ["mold"],
      "text": "No Spore was at the table but the oven took someone else: whoever holds a Team Mold card wins; if nobody does, nobody wins."
    }
