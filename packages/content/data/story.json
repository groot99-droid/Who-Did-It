      "chapters": [
        {
          "id": "ch1_baker",
          "title": "The Wake Loaf",
          "setup": "Day one in HollowMere. Crumb's ovens are cold, the train is due, and the whole town wants bread by nine. You are the Baker.",
          "roleId": "baker",
          "startPhase": { "cycle": 1, "part": "day" },
          "goals": [
            {
              "id": "gFlour",
              "text": "Haul the morning flour from the train",
              "trigger": {
                "event": "taskDone",
                "seat": "player",
                "data": { "taskId": "fetchFlour" }
              }
            },
            {
              "id": "gDough",
              "text": "Mix the dough at the bakery",
              "trigger": { "event": "taskDone", "seat": "player", "data": { "taskId": "mixDough" } }
            },
            {
              "id": "gBake",
              "text": "Prove the loaves and stoke the oven",
              "trigger": {
                "event": "taskDone",
                "seat": "player",
                "data": { "taskId": "proofLoaves" }
              }
            },
            { "id": "gTip", "text": "Find out who has been in your back room" }
          ],
          "beats": [
            {
              "id": "open",
              "trigger": { "tick": 0 },
              "action": {
                "seq": [
                  { "cutscene": "openingHollowmere" },
                  {
                    "card": "beat",
                    "line": "Before light, the cold room hums and the oven ticks as it cools. Out on the line the morning train is already a smudge of smoke. Flour first, then the fire.",
                    "speaker": "Dawn in HollowMere",
                    "portrait": "baker"
                  }
                ]
              },
              "oncePerChapter": true
            },
            {
              "id": "train",
              "trigger": { "event": "train.arrive" },
              "action": {
                "card": "beat",
                "line": "The iron beast rolls in on time and drops its sacks on the platform. Nobody carries flour for you; nobody ever has. Haul it to the bakery before the damp gets in.",
                "speaker": "The morning train"
              },
              "oncePerChapter": true
            },
            {
              "id": "flour",
              "trigger": {
                "event": "taskDone",
                "seat": "player",
                "data": { "taskId": "fetchFlour" }
              },
              "action": {
                "card": "beat",
                "line": "Twelve sacks, and your shoulders know every one. The lane is waking up: shutters, a pump handle, a cough. Mix the dough while the ovens still hold last night's heat.",
                "speaker": "Crumb's Bakery"
              },
              "oncePerChapter": true
            },
            {
              "id": "dough",
              "trigger": {
                "event": "taskDone",
                "seat": "player",
                "data": { "taskId": "mixDough" }
              },
              "action": {
                "card": "beat",
                "line": "Dough that rises slow is dough that tastes of patience, as your mother said. A stranger's boots stand in the square by the bell. He does not buy bread. He buys a look at your door.",
                "speaker": "The back room",
                "portrait": "baker"
              },
              "oncePerChapter": true
            },
            {
              "id": "watcher",
              "trigger": { "tick": 3600 },
              "action": {
                "npcOrder": { "npcId": "thief", "order": "goTo", "args": { "scene": "overworld" } }
              },
              "oncePerChapter": true
            },
            {
              "id": "visit",
              "trigger": { "tick": 4200 },
              "action": {
                "npcOrder": { "npcId": "thief", "order": "goTo", "args": { "scene": "bakery" } }
              },
              "oncePerChapter": true
            },
            {
              "id": "pick",
              "trigger": { "tick": 4800 },
              "action": {
                "seq": [
                  { "spawn": { "kind": "scratch", "at": "bakery:door" } },
                  {
                    "npcOrder": { "npcId": "thief", "order": "goTo", "args": { "scene": "forest" } }
                  }
                ]
              },
              "oncePerChapter": true
            },
            {
              "id": "tip",
              "trigger": {
                "any": [{ "event": "clue", "data": { "kind": "scratch" } }, { "tick": 5400 }]
              },
              "action": {
                "seq": [
                  { "spawn": { "kind": "letter", "at": "bakery:door" } },
                  {
                    "card": "beat",
                    "line": "Fresh scratches round the back-door lock, and on the cooling rack a single gold coin set square on a folded scrap: 'For the loaf. Keep the change.'",
                    "speaker": "The back room",
                    "goal": "gTip"
                  }
                ]
              },
              "oncePerChapter": true
            },
            {
              "id": "fence",
              "trigger": { "tick": 7200 },
              "action": {
                "card": "beat",
                "line": "A coin is a coin. You drop it in the till and the drawer sticks a moment, as if it knew. Somebody out in the lanes now thinks you are a friend of a certain sort, and a friend of that sort is never only a friend.",
                "speaker": "The Fence road",
                "portrait": "baker"
              },
              "oncePerChapter": true
            },
            {
              "id": "bell",
              "trigger": { "event": "bell" },
              "action": {
                "card": "beat",
                "line": "The town bell is ringing. Whatever it means, it will not wait for the oven.",
                "speaker": "The bell"
              },
              "oncePerChapter": true
            }
          ],
          "end": {
            "trigger": { "tick": 9000 },
            "summaryKeys": ["loavesBaked", "coinsKept", "tasksDone"],
            "lines": [
              "The last loaf is cooling, the door is bolted and the coin is still in the till drawer.",
              "HollowMere has eaten, and not one neighbour has asked where the Baker's luck comes from yet."
            ],
            "failedLine": "Your hands go still on the dough. The oven ticks on without you, and another pair of hands will light it in the morning."
          },
          "handOn": [
            {
              "kind": "lead",
              "ref": "scratch",
              "text": "You carry one thing out of the bakery: the scratch-marks round the back-door lock, and the face of the man who made them."
            }
          ]
        }
      ]
    }
  }
}
