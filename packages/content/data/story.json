      "id": "hollowmere_winter",
      "title": "A Winter in HollowMere",
      "blurb": "One town, three nights and days, three trades: the Baker whose coin has a story, the Watchman who follows the boots, and the Bandit who made them.",
      "mapId": "hollowmere",
      "roster": { "humanSeat": 0, "npcCount": 7 },
