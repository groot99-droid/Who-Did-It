{
  "session": "11F",
  "about": "The figure drops (round 11, F2 to Fn): each character model of tools/blender/models/models.lock.json, the look id it renders under, and the drop that ships it. Rendered by tools/blender/render_figures.py, halved by `pixel --finish off`, packed by `pack --style hd`, copied into apps/client/public/assets/figures/ by figures.ts.",
  "commands": [
    "EGL_PLATFORM=surfaceless tools/blender/.venv/bin/python tools/blender/render_figures.py --model <model> --look <look> --out <raw>",
    "pnpm -s --filter @wdi/sprites pixel <raw>/<look> <fin>/<look> --finish off",
    "pnpm -s --filter @wdi/sprites run pack <fin>/<look> <packed> --style hd",
    "pnpm -C tools/sprites exec tsx figures.ts <packed>"
  ],
