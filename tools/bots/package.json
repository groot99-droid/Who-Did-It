{
  "name": "@wdi/bots",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bots: lobby swarm (Playwright and lobby runs), walkers that report, vote and strike, and the 30 minute match soak (no tasks).",
  "scripts": {
    "start": "tsx swarm.ts",
    "walk": "tsx --conditions=development walk.ts",
    "soak": "tsx --conditions=development soak.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@wdi/content": "workspace:*",
    "@wdi/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
